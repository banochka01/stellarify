PORT=8787
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8787
PUBLIC_BASE_URL=https://music.example.com
AUTH_DB_PATH=./data/resonance.sqlite
CLIENT_VERSION=3.5.0
CLIENT_RELEASE_NOTES=Resonance 3.5: честное отсутствие клипа, MusicBrainz и TheAudioDB, официальный вход Spotify и база знаний по подключениям.
# Lyrics cascade: LRCLIB and Lyrics.ovh work without keys. Musixmatch is used
# only when your account and license permit it. Add up to twelve compatible HTTPS
# endpoints returning Resonance lyrics JSON or {"lyrics":"..."}.
LRCLIB_BASE_URL=https://lrclib.net
LYRICS_OVH_BASE_URL=https://api.lyrics.ovh
MUSIXMATCH_API_KEY=
LYRICS_FALLBACK_URLS=
# Optional extra secret mixed into password hashing. Changing it invalidates
# existing passwords, so configure it once before the first production account.
AUTH_PASSWORD_PEPPER=

# Optional server-side provider credentials. SoundCloud uses the public API v2
# Client ID flow used by Dotify; a user can enter their own Client ID in the app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match the HTTPS URI allow-listed in Spotify Dashboard. Defaults
# to PUBLIC_BASE_URL + /api/v1/auth/spotify/callback when omitted.
SPOTIFY_REDIRECT_URI=
SOUNDCLOUD_CLIENT_ID=
# Optional server-only authenticated IPv4 HTTP proxy. Credentials stay on the
# server; clients can only request it with X-SoundCloud-Proxy: enabled.
# Format: IPv4:port:login:password
SOUNDCLOUD_PROXY_URL=
YOUTUBE_API_KEY=

# Key-free official 30-second Apple Music video previews and public Dailymotion
# and MusicBrainz references. Disable a source if deployment policy requires it.
CLIP_APPLE_ENABLED=true
CLIP_APPLE_COUNTRIES=ru,us,gb
CLIP_DAILYMOTION_ENABLED=true
CLIP_MUSICBRAINZ_ENABLED=true
# Optional JSON catalog. Docker: place it in the existing /data volume.
CLIP_CATALOG_PATH=
# Up to twelve HTTPS APIs returning {"clips":[...]}; see docs/VIDEO_SOURCES.md.
CLIP_PROVIDER_URLS=
# Optional atmospheric video library; this key never leaves the server.
PEXELS_API_KEY=
# Optional Vimeo public-search token. YouTube search reuses YOUTUBE_API_KEY above.
VIMEO_ACCESS_TOKEN=
# Optional curated external music-video references.
AUDIODB_API_KEY=

# Optional server defaults. A client may override either credential per request
# with X-Provider-Token; these values must never reach Flutter or the browser.
YANDEX_MUSIC_TOKEN=
# VK API token with audio.* permissions; users may pass their own per request.
VK_ACCESS_TOKEN=

# Optional AgentRouter personalization for Plus/Family Wave. Without a key the
# same account signals still feed the deterministic local ranker. The LLM only
# returns search/ranking parameters; provider catalogs remain authoritative.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_MODEL=glm-5.2
AGENTROUTER_TIMEOUT_MS=4500
AGENTROUTER_CACHE_MS=3600000

# Admin-only Telegram promo bot (separate Compose profile: promo-bot).
# Telegram traffic MUST use an HTTP(S) CONNECT proxy with a literal IPv4 host;
# hostnames, IPv6, SOCKS and direct fallback are rejected.
# Keep these values server-only. Never publish .env or print `compose config` with secrets.
PROMO_BOT_TOKEN=
# Stable random secret (at least 32 characters) used only to derive idempotent
# promo plaintext. Do not rotate it with the Telegram bot token.
PROMO_CODE_SECRET=
PROMO_BOT_ADMIN_IDS=
# Format: http://username:URL-encoded-password@IPv4:port
PROMO_BOT_PROXY_URL=
